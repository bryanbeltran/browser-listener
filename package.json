{
  "name": "browser-listener",
  "version": "0.3.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "ext:path": "node -e \"import { resolve } from 'node:path'; console.log('Load unpacked:', resolve('dist'))\"",
    "bump:build": "node scripts/bump-and-build.mjs",
    "setup:hooks": "sh scripts/setup-git-hooks.sh",
    "prepare": "sh scripts/setup-git-hooks.sh"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/chrome": "^0.0.287",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
