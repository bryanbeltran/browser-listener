{
  "manifest_version": 3,
  "name": "Browser Listener",
  "version": "0.3.24",
  "description": "Capture consented Facebook activity locally and export a searchable, portable archive. No upload or telemetry.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "webRequest",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "https://facebook.com/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Listener"
  }
}
