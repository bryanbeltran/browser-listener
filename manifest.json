{
  "manifest_version": 3,
  "name": "Browser Listener",
  "version": "0.3.20",
  "description": "Collect and organize Facebook posts, comments, and reactions locally while you browse. Privacy-first ZIP export.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "tabs",
    "webRequest",
    "debugger",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Listener"
  }
}
