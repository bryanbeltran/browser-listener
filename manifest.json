{
  "manifest_version": 3,
  "name": "Browser Listener",
  "version": "0.1.0",
  "description": "Capture page console logs and network metadata for debugging.",
  "permissions": ["storage", "downloads", "tabs", "webRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "Browser Listener"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "type": "module"
    }
  ]
}
