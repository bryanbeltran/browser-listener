{
  "manifest_version": 3,
  "name": "Browser Listener",
  "version": "0.3.4",
  "description": "Privacy-first local browser session recorder with ZIP export and offline investigation report.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "webRequest",
    "debugger",
    "webNavigation",
    "pageCapture"
  ],
  "optional_permissions": [
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Listener"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "type": "module",
      "all_frames": true
    }
  ]
}
