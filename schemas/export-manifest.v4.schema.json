{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://browser-listener.dev/schemas/export-manifest.v4.schema.json",
  "title": "Browser Listener export manifest v4",
  "type": "object",
  "required": ["schemaVersion", "format", "version", "extensionVersion", "sessionId", "exportedAt", "privacy", "options", "files", "coverage", "health"],
  "properties": {
    "schemaVersion": { "const": 4 },
    "format": { "const": "browser-listener" },
    "version": { "type": "string" },
    "extensionVersion": { "type": "string" },
    "sessionId": { "type": "string" },
    "exportedAt": { "type": "integer", "minimum": 0 },
    "privacy": { "$ref": "#/$defs/privacy" },
    "options": { "$ref": "#/$defs/options" },
    "files": { "type": "array", "items": { "$ref": "#/$defs/file" } },
    "provenance": { "$ref": "#/$defs/provenance" },
    "coverage": { "$ref": "coverage.v4.schema.json" },
    "health": { "type": "object" }
  },
  "$defs": {
    "privacy": {
      "type": "object",
      "required": ["schemaVersion", "redactionEnabled", "redactionRuleSetVersion", "audit", "captureBodies", "captureConsole", "scope", "localOnly", "remoteUpload", "policyEpochs", "states", "fields", "exportDestination", "userConfirmedExceptions", "warnings"],
      "properties": {
        "schemaVersion": { "const": 2 },
        "redactionEnabled": { "type": "boolean" },
        "redactionRuleSetVersion": { "type": "string" },
        "audit": { "type": "object" },
        "captureBodies": { "type": "boolean" },
        "captureConsole": { "type": "boolean" },
        "scope": { "enum": ["active-tab", "selected-tabs"] },
        "localOnly": { "const": true },
        "remoteUpload": { "const": false },
        "policyEpochs": { "type": "array", "items": { "$ref": "coverage.v4.schema.json#/$defs/policyEpoch" } },
        "states": { "$ref": "coverage.v4.schema.json#/$defs/stateSummary" },
        "fields": {
          "type": "object",
          "required": ["urls", "headers", "requestBodies", "responseBodies", "consoleArguments", "navigationTitles", "visualEvidence"],
          "properties": {
            "urls": { "$ref": "#/$defs/privacyFieldReceipt" },
            "headers": { "$ref": "#/$defs/privacyFieldReceipt" },
            "requestBodies": { "$ref": "#/$defs/privacyFieldReceipt" },
            "responseBodies": { "$ref": "#/$defs/privacyFieldReceipt" },
            "consoleArguments": { "$ref": "#/$defs/privacyFieldReceipt" },
            "navigationTitles": { "$ref": "#/$defs/privacyFieldReceipt" },
            "visualEvidence": { "$ref": "#/$defs/privacyFieldReceipt" }
          }
        },
        "exportDestination": { "const": "local-device" },
        "userConfirmedExceptions": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "privacyFieldReceipt": {
      "type": "object",
      "required": ["captured", "excluded", "redacted", "truncated", "dropped", "unavailable"],
      "properties": {
        "captured": { "type": "integer", "minimum": 0 },
        "excluded": { "type": "integer", "minimum": 0 },
        "redacted": { "type": "integer", "minimum": 0 },
        "truncated": { "type": "integer", "minimum": 0 },
        "dropped": { "type": "integer", "minimum": 0 },
        "unavailable": { "type": "integer", "minimum": 0 }
      }
    },
    "options": {
      "type": "object",
      "required": ["profile", "captureBodies", "captureConsole", "redactionEnabled", "budgets"],
      "properties": {
        "profile": { "enum": ["metadata", "network-console", "safe-bodies"] },
        "captureBodies": { "type": "boolean" },
        "captureConsole": { "type": "boolean" },
        "redactionEnabled": { "type": "boolean" },
        "fields": { "$ref": "coverage.v4.schema.json#/$defs/fields" },
        "frameIds": { "type": "array", "items": { "type": "string" } },
        "durationMs": { "type": "integer", "minimum": 1 },
        "allowedOrigins": { "type": "array", "items": { "type": "string", "format": "uri" } },
        "targetTabIds": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
        "budgets": {
          "type": "object",
          "required": ["perOriginBytes", "perCategoryBytes"],
          "properties": {
            "perOriginBytes": { "type": "integer", "minimum": 1 },
            "perCategoryBytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "file": {
      "type": "object",
      "required": ["path", "kind", "optional", "enabled"],
      "properties": {
        "path": { "type": "string" },
        "kind": { "enum": ["report", "har", "json", "other"] },
        "optional": { "type": "boolean" },
        "enabled": { "type": "boolean" },
        "schemaVersion": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["schemaVersion", "deterministic", "checksumAlgorithm", "sourceSessionId", "exportedAt", "redactionRuleSetVersion", "manifestChecksumExcluded"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "deterministic": { "const": true },
        "checksumAlgorithm": { "const": "sha256" },
        "sourceSessionId": { "type": "string" },
        "exportedAt": { "type": "integer", "minimum": 0 },
        "redactionRuleSetVersion": { "type": "string" },
        "manifestChecksumExcluded": { "const": true }
      }
    }
  }
}
